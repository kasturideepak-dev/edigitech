# MySQL connection (Hostinger: hPanel → Databases → MySQL Databases)
DATABASE_URL="mysql://user:password@localhost:3306/edigitech_cms"

# Long random string used to sign admin session cookies (e.g. `openssl rand -base64 48`)
AUTH_SECRET="change-me"

# Public site URL (no trailing slash) – used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded media is stored. Use an absolute path OUTSIDE the app folder in production
# so redeploys don't wipe uploads, e.g. /home/u123456789/edigitech-uploads
UPLOAD_DIR="./storage/uploads"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@edigitech.in"
SEED_ADMIN_PASSWORD="ChangeMe@123"
