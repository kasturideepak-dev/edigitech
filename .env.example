# --- Database: use EITHER a URL or the discrete PG* variables ---
#
# 1) Connection URL (managed Postgres, or any TCP server)
#   Local:     postgres://YOUR_MAC_USER@localhost:5432/edigitech_cms   (Postgres.app)
#   Neon:      postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/edigitech?sslmode=require
#   Supabase:  postgres://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL="postgres://postgres:postgres@localhost:5432/edigitech_cms"

# 2) Discrete variables — REQUIRED when Postgres listens on a Unix socket rather
#    than TCP (common on shared hosting), because a socket path cannot be put in a
#    URL. Also avoids percent-encoding passwords containing @ : / ? or #.
#    PGHOST takes priority over DATABASE_URL when both are set.
# PGHOST="/var/run/postgresql"
# PGDATABASE="account_edigitech"
# PGUSER="account_dbuser"
# PGPASSWORD="raw password, no encoding needed"

DATABASE_SSL="false"

# Long random string used to sign admin session cookies (e.g. `openssl rand -base64 48`)
AUTH_SECRET="change-me"

# Public site URL (no trailing slash) – used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded media is stored. Use an absolute path OUTSIDE the app folder in production
# so redeploys don't wipe uploads, e.g. /home/u123456789/edigitech-uploads
UPLOAD_DIR="./storage/uploads"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@edigitech.in"
SEED_ADMIN_PASSWORD="ChangeMe@123"
