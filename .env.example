# PostgreSQL connection string.
#   Local:     postgres://YOUR_MAC_USER@localhost:5432/edigitech_cms   (Postgres.app)
#   Neon:      postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/edigitech?sslmode=require
#   Supabase:  postgres://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
#   OVIPanel:  postgres://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL="postgres://postgres:postgres@localhost:5432/edigitech_cms"

# Set to "false" for a local server with no TLS. Leave unset for managed Postgres (Neon/Supabase),
# which requires TLS — the default "prefer" negotiates it automatically.
DATABASE_SSL="false"

# Long random string used to sign admin session cookies (e.g. `openssl rand -base64 48`)
AUTH_SECRET="change-me"

# Public site URL (no trailing slash) – used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded media is stored. Use an absolute path OUTSIDE the app folder in production
# so redeploys don't wipe uploads, e.g. /home/u123456789/edigitech-uploads
UPLOAD_DIR="./storage/uploads"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@edigitech.in"
SEED_ADMIN_PASSWORD="ChangeMe@123"
